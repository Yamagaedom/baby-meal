{
  "name": "baby-meal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate --config prisma.config.ts && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "db:dev": "prisma dev -d -n baby-meal -P 54329",
    "db:generate": "prisma generate --config prisma.config.ts",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "tsx scripts/deploy-database.ts && tsx scripts/bootstrap-weekly.ts && tsx scripts/bootstrap-meal-styles.ts && tsx scripts/bootstrap-expanded-recipes.ts",
    "db:seed": "prisma db seed",
    "generate:batch": "tsx scripts/generate-batch-recipes.ts",
    "catalog:prepare": "tsx scripts/prepare-catalog-repair.ts",
    "catalog:sql": "node scripts/catalog-repair-sql.mjs",
    "catalog:check": "node scripts/check-catalog-repair.mjs",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "next": "16.4.3",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@electric-sql/pglite": "^0.3.15",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.5",
    "dotenv": "^18.0.9",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "^10.1.8",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "^7.10.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.5"
  }
}
