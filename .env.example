# PostgreSQL 연결 문자열 (Supabase 무료 플랜 또는 로컬 PostgreSQL / PGlite)
DATABASE_URL=

# Gemini API 키 (2-B단계 AI 레시피 생성용 — 서버 전용)
GEMINI_API_KEY=
# Gemini 모델명 (선택, 기본값: gemini-2.5-flash — 저지연·구조화 JSON 고신뢰 Flash 모델 권장)
# 옵션: gemini-2.5-flash (권장), gemini-2.0-flash, gemini-1.5-flash
GEMINI_MODEL=gemini-2.5-flash

# YouTube Data API v3 키 (2-B단계 출처 검색용 — 서버 전용)
YOUTUBE_API_KEY=

# 서비스 전체 1일 즉석 AI 생성 상한 (AI-11, 기본값 500)
AI_DAILY_GLOBAL_LIMIT=
